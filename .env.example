# ───────────────────────── قاعدة البيانات ─────────────────────────
# للإنتاج (PostgreSQL — Neon / Supabase / Railway / خادم خاص)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bacarabe?schema=public"

# للتطوير المحلي بدون خادم قاعدة بيانات، شغّل:  npm run db:use-sqlite
# ثم استعمل:
# DATABASE_URL="file:./dev.db"
#
# على Railway مع SQLite وقرص دائم مركّب على /data:
# DATABASE_URL="file:/data/app.db"
# ملاحظة: الملف يجب أن يكون داخل القرص الدائم، وإلا ضاعت البيانات عند كل نشر.

# ───────────────────────── الأمان والجلسات ─────────────────────────
# مفتاح توقيع الجلسات — ولّد مفتاحًا عشوائيًا طويلًا:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-please-a-long-random-string"
# مدة الجلسة بالأيام
AUTH_SESSION_DAYS="30"

# عنوان الموقع (يُستعمل في روابط الدفع وإعادة التوجيه)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ───────────────────────── حساب المسؤول الأول ─────────────────────────
# يُنشأ تلقائيًا عند تشغيل npm run db:seed
ADMIN_EMAIL="admin@bacarabe.sn"
ADMIN_PASSWORD="Admin@2026"
ADMIN_NAME="الأستاذ زكريا سي"

# ───────────────────────── بوابات الدفع ─────────────────────────
# المزوّدات المفعّلة (مفصولة بفاصلة): wave,orange_money,cmi,manual
PAYMENT_PROVIDERS="bictorys"
PAYMENT_CURRENCY="XOF"

# Wave (السنغال) — https://docs.wave.com
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""
WAVE_BASE_URL="https://api.wave.com/v1"

# Orange Money (Web Payment API)
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""
ORANGE_MONEY_BASE_URL="https://api.orange.com/orange-money-webpay/dev/v1"

# CMI (المغرب)
CMI_CLIENT_ID=""
CMI_STORE_KEY=""
CMI_BASE_URL="https://testpayment.cmi.co.ma/fim/est3Dgate"

# الدفع اليدوي (تحويل + رفع إيصال + تفعيل من لوحة الإدارة)
MANUAL_PAYMENT_INSTRUCTIONS="حوّل المبلغ عبر Wave أو Orange Money إلى الرقم +212 632 09 22 92 ثم ارفع صورة الإيصال."

# ───────────────────────── تخزين الملفات ─────────────────────────
# local | s3 | bunny
STORAGE_DRIVER="local"
# مجلّد الملفات المرفوعة — خارج public عمدًا، وتُقدَّم عبر مسار /uploads
# محليًا: uploads   |   على Railway (قرص دائم): /data/uploads
STORAGE_LOCAL_DIR="uploads"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ───────────────────────── Bictorys (بوابة الدفع) ─────────────────────────
# لوحة التحكّم: https://dashboard.bictorys.com — التوثيق: https://docs.bictorys.com
# عنوان الاختبار جاهز أدناه. عنوان الإنتاج غير منشور في التوثيق:
# اطلبه من لوحتك أو من دعم Bictorys وضعه هنا عند الانتقال للإنتاج.
BICTORYS_BASE_URL="https://api.test.bictorys.com"
# المفتاح العامّ (للواجهة الأمامية)
BICTORYS_PUBLIC_KEY=""
# المفتاح السرّي (للنداءات من الخادم) — هو المطلوب فعليًا، ضعه بنفسك
BICTORYS_SECRET_KEY=""
# مفتاح الإشعارات: اختر نصًّا عشوائيًا وضعه هنا وفي لوحة Bictorys
# بدونه تُرفض كل الإشعارات، فلا يُفعَّل أي اشتراك
BICTORYS_WEBHOOK_SECRET=""
BICTORYS_COUNTRY="SN"
